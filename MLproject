name: steel-energy-mlops

entry_points:
  prepare:
    parameters:
      input: {type: path, default: data/coursework/Steel_industry_data_5000.csv}
      output: {type: str, default: data/processed}
    command: python -m steel_energy_mlops prepare-data --input {input} --output {output}
  train:
    parameters:
      data: {type: path, default: data/processed}
      workspace: {type: str, default: artifacts/mlflow}
    command: python -m steel_energy_mlops train --data {data} --workspace {workspace}
  predict:
    parameters:
      timestamp: str
      workspace: {type: str, default: artifacts/mlflow}
    command: python -m steel_energy_mlops predict --timestamp {timestamp} --workspace {workspace}
